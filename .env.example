# OIDC Provider Configuration
# Examples for Keycloak running locally on port 8080:
# ISSUER=http://localhost:8080/realms/master
# ...

ISSUER=https://<your-idp-domain>/realms/<realm-name>
AUTHORIZATION_URI=https://<your-idp-domain>/realms/<realm-name>/protocol/openid-connect/auth
TOKEN_URI=https://<your-idp-domain>/realms/<realm-name>/protocol/openid-connect/token
USERINFO_URI=https://<your-idp-domain>/realms/<realm-name>/protocol/openid-connect/userinfo
LOGOUT_URI=https://<your-idp-domain>/realms/<realm-name>/protocol/openid-connect/logout

# Client Configuration
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Redirect URI (Frontend Callback)
# Ensure this matches your Flask app's port (e.g., 2312)
REDIRECT_URI=http://localhost:2312/OIDC/wso2/authorized

# Scopes
OIDC_SCOPES=openid email phone profile roles

# Flask App Configuration
# Leave empty to auto-generate a generic key, or set a fixed random string for production
FLASK_SECRET_KEY=
